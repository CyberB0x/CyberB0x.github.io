<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Project Choices</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">

  <div class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-4xl font-bold text-center mb-10 text-gray-800">Choose Your Project</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      
      <!-- Free Projects Card -->
      <div class="bg-white shadow-lg rounded-xl p-6 transform transition hover:scale-105 hover:shadow-2xl cursor-pointer">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-semibold text-gray-800">Free Projects</h2>
          <span class="text-green-500 font-bold bg-green-100 px-3 py-1 rounded-full text-sm">Free</span>
        </div>
        <p class="text-gray-600 mb-4">
          Access a variety of free-to-use project templates and resources.
        </p>
        <button class="mt-auto bg-green-500 hover:bg-green-600 text-white font-medium py-2 px-4 rounded-lg transition">
          Explore Free
        </button>
      </div>

      <!-- Buy Projects Card -->
      <div class="bg-white shadow-lg rounded-xl p-6 transform transition hover:scale-105 hover:shadow-2xl cursor-pointer">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-semibold text-gray-800">Buy Projects</h2>
          <span class="text-purple-500 font-bold bg-purple-100 px-3 py-1 rounded-full text-sm">Premium</span>
        </div>
        <p class="text-gray-600 mb-4">
          Unlock high-quality premium projects designed by professionals.
        </p>
        <button class="mt-auto bg-purple-500 hover:bg-purple-600 text-white font-medium py-2 px-4 rounded-lg transition">
          Browse Premium
        </button>
      </div>

    </div>
  </div>

</body>
</html>
